# Copy this file to `.env` and edit the values you need.

# Delta Exchange endpoints. Use the India host for BTCUSD / ETHUSD perpetuals.
DELTA_REST_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange

# Comma-separated list of perpetual symbols to subscribe to.
SYMBOLS=BTCUSD,ETHUSD

# Origin allowed by CORS and Socket.IO. Match the frontend dev URL.
ALLOWED_ORIGIN=http://localhost:3000
